name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  # First Job: Runs unit tests
  tests:
    name: Tests
    runs-on: ubuntu-latest
    steps:
      - name: Install gosec
        run: go install github.com/securego/gosec/v2/cmd/gosec@latest
      - name: Check out code
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: "1.25.1"

      - name: Go Test
        run: go test ./...
      - name: GoSec Run
        run: gosec ./...
  # Second Job: Runs in parallel to check formatting
  style:
    name: Style
    runs-on: ubuntu-latest
    steps:
      - name: Install staticcheck
        run: go install honnef.co/go/tools/cmd/staticcheck@latest
      - name: Check out code
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: "1.25.1"

      - name: Go Format Test
        run: test -z "$(go fmt ./...)"

      - name: CI Linting
        run: staticcheck ./...
